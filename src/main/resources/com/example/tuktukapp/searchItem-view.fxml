<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tuktukjava.controllers.SearchController"
      prefWidth="730" prefHeight="600" spacing="0"
      style="-fx-background-color: white;">

    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #f5f5f5;">
        <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
        <Button text="← Search parts" onAction="#onBackBtnClick"
                style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 15; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" right="24" bottom="0" left="24"/></padding>

        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Name" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                <TextField fx:id="nameField" promptText="e.g. Brake Pad"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Brand" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                <TextField fx:id="brandField" promptText="e.g. Bajaj"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Category" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                <TextField fx:id="categoryField" promptText="e.g. Engine"/>
            </VBox>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="Min price" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                <TextField fx:id="minPriceField" promptText="0" prefWidth="160"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Max price" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                <TextField fx:id="maxPriceField" promptText="99999" prefWidth="160"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Min qty" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                <TextField fx:id="minQtyField" promptText="0" prefWidth="160"/>
            </VBox>
            <VBox spacing="4" alignment="BOTTOM_LEFT">
                <Label text=" "/>
                <Button text="Clear" onAction="#onClearBtnClick" prefWidth="100" prefHeight="32"
                        style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;"/>
            </VBox>
            <VBox spacing="4" alignment="BOTTOM_LEFT">
                <Label text=" "/>
                <Button text="Search" onAction="#onSearchBtnClick" prefWidth="120" prefHeight="32"
                        style="-fx-background-color: #222; -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6;"/>
            </VBox>
        </HBox>

        <HBox style="-fx-background-color: #f0f0f0; -fx-padding: 8 0 8 0;">
            <Label text="Code"     prefWidth="80"  style="-fx-font-size: 12; -fx-text-fill: #888;"/>
            <Label text="Name"     prefWidth="240" style="-fx-font-size: 12; -fx-text-fill: #888;"/>
            <Label text="Brand"    prefWidth="100" style="-fx-font-size: 12; -fx-text-fill: #888;"/>
            <Label text="Price"    prefWidth="110" style="-fx-font-size: 12; -fx-text-fill: #888;"/>
            <Label text="Qty"      prefWidth="60"  style="-fx-font-size: 12; -fx-text-fill: #888;"/>
            <Label text="Category" prefWidth="100" style="-fx-font-size: 12; -fx-text-fill: #888;"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: white; -fx-border-color: transparent;">
            <VBox fx:id="resultBox" spacing="0">
                <padding><Insets top="4" right="0" bottom="4" left="0"/></padding>
            </VBox>
        </ScrollPane>

        <Label fx:id="resultLabel" style="-fx-font-size: 12; -fx-text-fill: #555;"/>

    </VBox>

    <Separator/>

    <HBox alignment="CENTER_LEFT">
        <padding><Insets top="10" right="24" bottom="16" left="24"/></padding>
        <Button text="← Back" onAction="#onBackBtnClick" prefWidth="130" prefHeight="36"
                style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;"/>
    </HBox>
</VBox>
