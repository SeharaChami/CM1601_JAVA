<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500" prefWidth="730" spacing="0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tuktukjava.controllers.AddItemController">

   <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #f5f5f5;">
      <padding><Insets bottom="14" left="24" right="24" top="14" /></padding>
      <Button fx:id="backBtn" onAction="#onBackBtnClick" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 15; -fx-font-weight: bold;" text="← Add item" />
   </HBox>

   <VBox spacing="14" VBox.vgrow="ALWAYS">
      <padding><Insets bottom="0" left="24" right="24" top="20" /></padding>

      <HBox spacing="12">
         <VBox prefWidth="150" spacing="4">
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Item code" />
            <TextField fx:id="itemCodeField" editable="false" prefWidth="150" style="-fx-background-color: #f0f0f0; -fx-alignment: center;" />
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Part name" />
            <TextField fx:id="nameField" onAction="#onNameText" promptText="e.g. Brake Pad" />
            <Label fx:id="nameLabel" style="-fx-text-fill: red; -fx-font-size: 11;" />
         </VBox>
      </HBox>

      <HBox spacing="12">
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Brand" />
            <TextField fx:id="brandField" onAction="#onBrandText" promptText="e.g. Bajaj" />
            <Label fx:id="brandLabel" style="-fx-text-fill: red; -fx-font-size: 11;" />
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Price (Rs)" />
            <TextField fx:id="priceField" onAction="#onPriceText" promptText="e.g. 1250" />
            <Label fx:id="priceLabel" style="-fx-text-fill: red; -fx-font-size: 11;" />
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Quantity" />
            <TextField fx:id="quantityField" onAction="#onQtyText" promptText="e.g. 15" />
            <Label fx:id="qtyLabel" style="-fx-text-fill: red; -fx-font-size: 11;" />
         </VBox>
      </HBox>

      <HBox spacing="12">
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Category" />
            <TextField fx:id="fieldInput" onAction="#onFieldText" promptText="e.g. Engine" />
            <Label fx:id="fieldLabel" style="-fx-text-fill: red; -fx-font-size: 11;" />
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Date" />
            <DatePicker fx:id="datePicker" onAction="#onDatePicker" />
            <Label fx:id="dateLabel" style="-fx-text-fill: red; -fx-font-size: 11;" />
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Image" />
            <Button maxWidth="Infinity" onAction="#onChooseImageClick" prefHeight="25" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4;" text="Choose Image" />
            <Label fx:id="imgLabel" style="-fx-text-fill: #666; -fx-font-size: 11;" />
         </VBox>
      </HBox>
      <VBox spacing="4">
         <children>
            <Label style="-fx-font-size: 11; -fx-text-fill: #666;" text="Threshold" />
            <TextField fx:id="thresholdField" maxWidth="-Infinity" prefWidth="100" promptText="Default 10" />
            <Label fx:id="fieldLabel1" style="-fx-text-fill: red; -fx-font-size: 11;" />
         </children>
      </VBox>
      <Label fx:id="msgLabel" style="-fx-font-size: 12;">
         <font>
            <Font size="30.0" />
         </font></Label>

   </VBox>

   <HBox alignment="CENTER_RIGHT" spacing="12">
      <padding><Insets bottom="16" left="24" right="24" top="8" /></padding>
      <Button fx:id="clearBtn" onAction="#onClearBtnClick" prefHeight="39" prefWidth="97" style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;" text="Clear" />
      <Button fx:id="addItem" onAction="#onAddButtonClick" prefHeight="39" prefWidth="97" style="-fx-background-color: #222; -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6;" text="Add item" />
   </HBox>
</VBox>
