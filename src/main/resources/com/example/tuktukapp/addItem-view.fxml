<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tuktukjava.controllers.AddItemController"
      prefWidth="730" prefHeight="500" spacing="0"
      style="-fx-background-color: white;">

   <HBox alignment="CENTER_LEFT" spacing="12"
         style="-fx-background-color: #f5f5f5;">
      <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
      <Button fx:id="backBtn" text="← Add item" onAction="#onBackBtnClick"
              style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 15; -fx-font-weight: bold;"/>
   </HBox>

   <VBox spacing="14" VBox.vgrow="ALWAYS">
      <padding><Insets top="20" right="24" bottom="0" left="24"/></padding>

      <HBox spacing="12">
         <VBox spacing="4" prefWidth="150">
            <Label text="Item code" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
            <TextField fx:id="itemCodeField" editable="false"
                       prefWidth="150"
                       style="-fx-background-color: #f0f0f0; -fx-alignment: center;"/>
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Part name" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
            <TextField fx:id="nameField" promptText="e.g. Brake Pad" onAction="#onNameText"/>
            <Label fx:id="nameLabel" style="-fx-text-fill: red; -fx-font-size: 11;"/>
         </VBox>
      </HBox>

      <HBox spacing="12">
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Brand" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
            <TextField fx:id="brandField" promptText="e.g. Bajaj" onAction="#onBrandText"/>
            <Label fx:id="brandLabel" style="-fx-text-fill: red; -fx-font-size: 11;"/>
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Price (Rs)" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
            <TextField fx:id="priceField" promptText="e.g. 1250.00" onAction="#onPriceText"/>
            <Label fx:id="priceLabel" style="-fx-text-fill: red; -fx-font-size: 11;"/>
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Quantity" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
            <TextField fx:id="quantityField" promptText="e.g. 15" onAction="#onQtyText"/>
            <Label fx:id="qtyLabel" style="-fx-text-fill: red; -fx-font-size: 11;"/>
         </VBox>
      </HBox>

      <HBox spacing="12">
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Category" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
            <TextField fx:id="fieldInput" promptText="e.g. Engine" onAction="#onFieldText"/>
            <Label fx:id="fieldLabel" style="-fx-text-fill: red; -fx-font-size: 11;"/>
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Date" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
            <DatePicker fx:id="datePicker" onAction="#onDatePicker"/>
            <Label fx:id="dateLabel" style="-fx-text-fill: red; -fx-font-size: 11;"/>
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Image filename" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
            <TextField fx:id="imgField" promptText="e.g. part.jpg" onAction="#onImgRefField"/>
            <Label fx:id="imgLabel" style="-fx-text-fill: red; -fx-font-size: 11;"/>
         </VBox>
      </HBox>

      <Label fx:id="msgLabel" style="-fx-font-size: 12;"/>

   </VBox>

   <HBox spacing="12" alignment="CENTER_RIGHT">
      <padding><Insets top="8" right="24" bottom="16" left="24"/></padding>
      <Button fx:id="clearBtn" text="Clear" onAction="#onClearBtnClick"
              prefWidth="97" prefHeight="39"
              style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-background-color: white;"/>
      <Button fx:id="addItem" text="Add item" onAction="#onAddButtonClick"
              prefWidth="97" prefHeight="39"
              style="-fx-background-color: #222; -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6;"/>
   </HBox>
</VBox>