<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tuktukjava.controllers.HomeController"
      prefWidth="730" prefHeight="500" spacing="0"
      style="-fx-background-color: white;">

   <VBox style="-fx-background-color: #f5f5f5;">
      <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
      <Label text="Malabe Tuk-Tuk" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
      <Label text="Three-Wheeler SparesDepot" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
   </VBox>

   <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
               style="-fx-background: white; -fx-border-color: transparent;">
      <VBox spacing="12">
         <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

         <Label text="INVENTORY" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
         <Separator/>
         <HBox spacing="12">
            <Button fx:id="AddBtn" text="Add Item&#10;New spare part" onAction="#onAddBtnClick"
                    prefWidth="130" prefHeight="85" wrapText="true"
                    style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button fx:id="UpdateBtn" text="Update Item&#10;Edit existing part" onAction="#onUpdateBtnClick"
                    prefWidth="130" prefHeight="85" wrapText="true"
                    style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button fx:id="DeleteBtn" text="Delete Item&#10;Remove a part" onAction="#onDeleteBtnClick"
                    prefWidth="130" prefHeight="85" wrapText="true"
                    style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button fx:id="ViewInventoryBtn" text="View Inventory&#10;View spare parts" onAction="#onviewBtnClick"
                    prefWidth="130" prefHeight="85" wrapText="true"
                    style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
         </HBox>

         <Label text="DEALERS" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
         <Separator/>
         <HBox spacing="12">
            <Button fx:id="DealerViewerBtn" text="View Dealers&#10;Random dealers" onAction="#onDealerBtnClick"
                    prefWidth="130" prefHeight="85" wrapText="true"
                    style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
         </HBox>

         <Label text="SALES" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
         <Separator/>
         <HBox spacing="12">
            <Button fx:id="cartDisBtn" text="Point Of Sale&#10;Cart + Discounts" onAction="#onCartBtnClick"
                    prefWidth="130" prefHeight="85" wrapText="true"
                    style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button fx:id="SearchBtn" text="Search Parts&#10;Multi criteria" onAction="#onSearchBtnClick"
                    prefWidth="130" prefHeight="85" wrapText="true"
                    style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
         </HBox>

      </VBox>
   </ScrollPane>

   <Label fx:id="welcomeText"/>
</VBox>